[gd_scene format=3]

[ext_resource type="Script" path="res://credits.gd" id="1_credits"]
[ext_resource type="PackedScene" path="res://background.tscn" id="2_bg"]

[node name="Credits" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_credits")

[node name="Background" parent="." instance=ExtResource("2_bg")]
layout_mode = 1

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Heading" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 90
theme_override_constants/outline_size = 16
text = "credits"
horizontal_alignment = 1

[node name="Panel" type="PanelContainer" parent="Center/VBox"]
custom_minimum_size = Vector2(620, 0)
layout_mode = 2

[node name="Rows" type="VBoxContainer" parent="Center/VBox/Panel"]
